_satellite.__registerScript("/__mirror/assets/8519c7a97cc15727c5b692f7", "//------------------------------------------------------------------------------------------------//\n//---------------------------- AI for Dev --------------------------------------//\n//------------------------------------- Page Load -------------------------------------------------//\n\nvar ruleCorrelationGuid = \"KIF-12397ae8-e0bc-4402-8b39-240e653081d1\"; //Guid uniquely identifies the rule\nconsole.log(ruleCorrelationGuid + \": Launcher Rule Fired\"); \n\nvar userConsent = !(typeof(window.mscc) !== \"undefined\" && typeof(window.mscc.hasConsent) === \"function\" && !window.mscc.hasConsent());\nif (!userConsent) {\n     console.log(ruleCorrelationGuid + \": User consent is not given\");\n}\n  \nif (userConsent) {\n    if (GPC_DataSharingOptIn) {\n        console.log(ruleCorrelationGuid + \": Loading pixels\");\n        var cachebuster = _satellite.getVar(\"cachebuster\");\n        var encodedUrl = (function() {\n            var pageUrl = window.location.href;\n            var urlWithoutQueryString = pageUrl.split('?')[0];\n            var encodedUrl = encodeURIComponent(urlWithoutQueryString);\n            return encodedUrl;\n          })();\n\n        //--------------------------- GCM Pixel--------------------------------------//\n        console.log(ruleCorrelationGuid + \": GCM pixel\");  \n        var gcmPixel = new Image(1, 1);\n        gcmPixel.src = \"https://ad.doubleclick.net/ddm/activity/src=8406079;type=atm;cat=lp_std;u6=AIforDevelopers;gdpr=${GDPR};gdpr_consent=${GDPR_CONSENT_755};ord=\" + cachebuster + \"?\";\n\n        //--------------------------- Reddit Pixel--------------------------------------//\n        console.log(ruleCorrelationGuid + \": Reddit pixel\");  \n        var redditPixel = new Image(1, 1);\n        redditPixel.src = \"https://alb.reddit.com/rp.gif?id=a2_g6mrhfo0xptj&event=PageVisit&integration=noscript\";  \n\n        //--------------------------- TTD Pixel--------------------------------------//\n        console.log(ruleCorrelationGuid + \": TTD pixel\");  \n        var ttdPixel = new Image(1, 1);\n        ttdPixel.src = \"https://insight.adsrvr.org/track/pxl/?adv=tq5ketp&ct=0:u1mddgg&fmt=3\";\n        \n        //------------------------------ LinkedIn pixel -----------------------------------------//\n        console.log(ruleCorrelationGuid + \": LinkedIn pixel\");\n        var liPixel = new Image(1, 1);\n        liPixel.src = \"https://px.ads.linkedin.com/collect/?fmt=gif&pid=7850&url=\" + encodedUrl;  \n    \n        //------------------------------ Meta pixel -----------------------------------------//\n        console.log(ruleCorrelationGuid + \": Meta pixel\");\n        var metaPixel = new Image(1, 1);\n        metaPixel.src = \"https://www.facebook.com/tr?id=1770559986549030&ev=PageView&dpo=LDU&dpoco=0&dpost=0&noscript=1&ts=\"+cachebuster+\"&dl=\" + encodedUrl; \n      \n        //------------------------------ Xandr pixel -----------------------------------------//\n        console.log(ruleCorrelationGuid + \": Xandr pixel\");\n        var xandrPixel = new Image(1, 1);\n        xandrPixel.src = \"https://ib.adnxs.com.adnxs.com/px?id=1832574&t=2&consent=1\"; \n      \n      \n    }\n}");